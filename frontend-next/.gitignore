# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# suite browser Playwright (report, trace, screenshot: artefatti di corsa)
/e2e/artifacts/
# spec esplorativi temporanei (vedi e2e/support/esplora.ts): mai committati
/e2e/esplora*.e2e.ts

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# identità dello stack E2E dedicato (scritta da `bun run e2e:stack up`, VPM-018-FIX-E2E-01)
/e2e/.stack-e2e.json
