# Supabase — Fase 5a (autenticazione reale). Project URL e anon/public key
# si trovano in Supabase → Settings → API. Mai la service_role key: non
# appartiene al bundle client e non deve mai finire in un file NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fase 7: disattivata per default. La variabile pubblica controlla soltanto la
# UI; l'autorizzazione effettiva resta in database e nei componenti server.
NEXT_PUBLIC_PHASE_7_PAYMENTS_ENABLED=false
PAYMENTS_ENABLED=false

# Chiave publishable Stripe: serve al Payment Element, che gira nel browser.
# Solo `pk_test_…` fuori produzione. Non è un segreto, ma identifica l'ambiente.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Solo server (Vercel Route Handler / Supabase Edge Function). Mai NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_ALLOWED_ORIGINS=http://localhost:3000
PAYMENT_REDIRECT_ALLOWED_ORIGINS=http://localhost:3000
PAYMENT_REDIRECT_ORIGIN=http://localhost:3000
PAYMENTS_WEBHOOK_RATE_LIMIT=600
PAYMENTS_WEBHOOK_RATE_WINDOW_SECONDS=60

# Fase 7b — Connect e trattenuta fondi. Paese degli account Express aperti per i
# venditori; il token del job di rilascio è indipendente dalla service role key
# e revocabile da solo.
CONNECT_ACCOUNT_COUNTRY=IT
PAYOUTS_JOB_TOKEN=
PAYOUTS_BATCH_LIMIT=50
