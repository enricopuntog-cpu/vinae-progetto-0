# Supabase — Fase 5a (autenticazione reale). Project URL e anon/public key
# si trovano in Supabase → Settings → API. Mai la service_role key: non
# appartiene al bundle client e non deve mai finire in un file NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fase 7: default versionato fail-closed. Nella build beta la UI checkout viene
# impostata a true, mentre PAYMENT_ACTIONS e PAYMENTS_ENABLED restano false: il
# flusso arriva al riepilogo finale ma si ferma prima di creare client o ordini.
# La variabile pubblica controlla soltanto la UI.
NEXT_PUBLIC_PHASE_7_PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENT_ACTIONS_ENABLED=false
PAYMENTS_ENABLED=false

# Chiave publishable Stripe: serve al Payment Element, che gira nel browser.
# Solo `pk_test_…` fuori produzione. Non è un segreto, ma identifica l'ambiente.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Solo server (Vercel Route Handler / Supabase Edge Function). Mai NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_ALLOWED_ORIGINS=http://localhost:3000
PAYMENT_REDIRECT_ALLOWED_ORIGINS=http://localhost:3000
PAYMENT_REDIRECT_ORIGIN=http://localhost:3000
PAYMENTS_WEBHOOK_RATE_LIMIT=600
PAYMENTS_WEBHOOK_RATE_WINDOW_SECONDS=60

# Fase 7b — Connect e trattenuta fondi. Paese degli account Express aperti per i
# venditori; il token del job di rilascio è indipendente dalla service role key
# e revocabile da solo.
CONNECT_ACCOUNT_COUNTRY=IT
PAYOUTS_JOB_TOKEN=
PAYOUTS_BATCH_LIMIT=50

# Fase 7c — preferenza di imballaggio del solo flusso checkout beta.
# Flag INDIPENDENTE da quella dei pagamenti, in entrambe le direzioni: può
# restare accesa con PAYMENTS_ENABLED spento e viceversa. Come per la Fase 7 la
# variabile pubblica controlla soltanto la UI, quella server è il gate.
# Nessun punto, etichetta, tracking o corriere viene contattato nella beta.
NEXT_PUBLIC_PACKAGING_ENABLED=false
PACKAGING_ENABLED=false

# Pre-lancio beta: visibilità delle sole tre superfici IA della Fase 10. La
# build beta usa UI=true e ACTIONS=false; l'esempio resta chiuso per default.
# Fallisce chiusa; soltanto la stringa esatta "true" monta la UI. Essendo
# NEXT_PUBLIC non autorizza chiamate: il gate autoritativo resta AI_ENABLED
# nell'ambiente delle Edge Function.
NEXT_PUBLIC_AI_UI_ENABLED=false
NEXT_PUBLIC_AI_ACTIONS_ENABLED=false

# Selettore Guest/User/Admin riservato allo sviluppo locale. Non abilita dati
# mock come fallback: nella beta il ruolo e i dati derivano da Supabase e, se
# il servizio manca, la superficie fallisce chiusa.
NEXT_PUBLIC_DEMO_UI_ENABLED=false

# Fase 10 — funzioni AI. Tutte queste vivono nell'ambiente della Edge Function
# su Supabase, non qui: questo file le elenca perché siano note, non perché
# vadano riempite in un .env del frontend. Nessuna chiave AI deve raggiungere il
# browser, e nessuna di queste è NEXT_PUBLIC_*.
#
# AI_ENABLED è il gemello di PAYMENTS_ENABLED e fallisce CHIUSO: assente o
# diverso da "true" significa spento, e ogni function AI risponde 503. È ciò che
# rende sicuro mergiare la fase prima che le chiavi esistano, dato che il merge
# distribuisce le function entro un minuto con l'ambiente che trova.
AI_ENABLED=false

# Allowlist CORS delle SOLE function AI. Non sostituisce PAYMENT_ALLOWED_ORIGINS
# e non la tocca: la decisione 7.6 ha respinto il rename proprio per non far
# passare il percorso dei pagamenti da un file che la Fase 10 modifica.
AI_ALLOWED_ORIGINS=http://localhost:3000

# Fornitore. La decisione 7.1 vuole un modello per compito e non uno per
# progetto: OpenAI è il tentativo, da confermare su conversazioni reali, e
# l'adapter regge la sostituzione senza refactoring. Senza chiave il provider è
# quello disabilitato e ogni chiamata dà 503.
OPENAI_API_KEY=
AI_MODEL_DEFAULT=gpt-4.1-mini
AI_MODEL_CHAT=
AI_MODEL_PAIRING=
AI_MODEL_CATALOGO=
AI_MAX_OUTPUT_TOKENS=800

# Tenuto un ordine di grandezza sotto i 150 s della piattaforma: un 504 di
# gateway non ha corpo e non è distinguibile da un guasto nostro.
AI_TIMEOUT_SECONDS=30
