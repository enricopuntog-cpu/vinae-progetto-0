# WI-015 — processi del Company Brain. Solo segnaposto: nessun segreto nel repository.
# Worker: spento per difetto; si accende solo con la stringa esatta true.
VINEA_WORKER_ENABLED=false
# Login dedicato dell’agente creato da agente/registra.sql (mai proprietario o service_role).
VINEA_AGENT_DATABASE_URL=
# Mittente dei segnali: login membro solo di brain_ingest. Vuoto = non configurato.
VINEA_INGEST_DATABASE_URL=
# WI-016: certificato PUBBLICO della CA del progetto; obbligatorio fuori da loopback (catena e nome verificati).
VINEA_DB_CA_PEM=
# WI-016: osservatore indipendente dell’heartbeat, login membro solo di brain_monitor_read. Vuoto = non configurato.
VINEA_OBSERVER_DATABASE_URL=
